# Local configuration and secrets
.env
.env.*
!.env.example
!web/.env.example

# Python caches and local environments
**/.venv/
**/__pycache__/
*.py[cod]

# Local agent/Codex metadata and editor caches
**/.codex/
**/.agents/
**/.cache/
**/.runtime/
.DS_Store
Thumbs.db

# Frontend dependencies and build output
web/node_modules/
web/dist/
web/.next/
web/.vinext/
web/.wrangler/
web/coverage/
web/tmp/
*.tsbuildinfo

# Learner runtime data and rebuildable RAG indexes
web/runtime/
agent/storage/
agent/rag/storage/local_kb/indexes/

# Logs and machine-local output
*.log
web-start.out
web-start.err

# Large course videos are provisioned separately from normal Git history
*.mp4
